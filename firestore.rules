rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ใส่อีเมลผู้ดูแลระบบ (ตัวพิมพ์เล็ก) ให้ตรงกับ ADMIN_EMAILS ใน firebase-config.js
    function adminEmails() { return ['your.name@gmail.com']; }

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && myEmail() in adminEmails(); }
    function isMember() {
      return signedIn() && (isAdmin() ||
        exists(/databases/$(database)/documents/members/$(myEmail())));
    }

    // รายชื่อสมาชิกที่อนุญาต: ผู้ดูแลเท่านั้นที่เพิ่ม/ลบได้
    match /members/{email} {
      allow get: if signedIn() && (isMember() || email == myEmail());
      allow list: if isMember();
      allow write: if isAdmin();
    }

    // งานติดตั้ง: สมาชิกทุกคนอ่านและแก้ไขได้
    match /jobs/{jobId} {
      allow read, write: if isMember();
    }

    // รูปถ่ายงานติดตั้ง (เก็บเป็นรูปย่อขนาดในเอกสาร ไม่ต้องใช้ Firebase Storage)
    match /photos/{photoId} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
    }

    // โปรไฟล์ (ชื่อ/รูป) ใช้แสดงผล: แก้ไขได้เฉพาะของตัวเอง
    match /users/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }

    // สถานะออนไลน์: เขียนได้เฉพาะของตัวเอง
    match /presence/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }
  }
}
